{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StaDesk",
  "version": "0.1.0",
  "identifier": "dev.stade.stadesk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StaDesk",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good"
        ]
      }
    },
    "shortDescription": "Secure remote desktop by Stade Development",
    "category": "Utility",
    "publisher": "Stade Development"
  }
}
